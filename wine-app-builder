#!/usr/bin/env python3
import sys
import os
import subprocess
import re
import gi

gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, Gio, GLib

class WineAppBuilder(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.local.WineAppBuilder",
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        self.win = Gtk.ApplicationWindow(application=self, title="Wine App Builder")
        self.win.set_default_size(450, 250)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(15)
        box.set_margin_bottom(15)
        box.set_margin_start(15)
        box.set_margin_end(15)
        self.win.set_child(box)

        exe_label = Gtk.Label(label="Select Windows Executable (.exe):", xalign=0)
        box.append(exe_label)

        file_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.append(file_box)

        self.exe_entry = Gtk.Entry()
        self.exe_entry.set_hexpand(True)
        file_box.append(self.exe_entry)

        browse_btn = Gtk.Button(label="Browse...")
        browse_btn.connect("clicked", self.on_browse_clicked)
        file_box.append(browse_btn)

        name_label = Gtk.Label(label="Application Display Name:", xalign=0)
        box.append(name_label)

        self.name_entry = Gtk.Entry()
        box.append(self.name_entry)

        self.create_btn = Gtk.Button(label="Integrate System Application")
        self.create_btn.add_css_class("suggested-action") # Makes button blue/green
        self.create_btn.connect("clicked", self.on_create_clicked)
        box.append(self.create_btn)

        self.status_label = Gtk.Label(label="", xalign=0.5)
        box.append(self.status_label)

        self.win.present()

    def on_browse_clicked(self, widget):
        dialog = Gtk.FileDialog(title="Choose a Wine .exe File")
        
        exe_filter = Gtk.FileFilter()
        exe_filter.set_name("Windows Executables (*.exe)")
        exe_filter.add_pattern("*.exe")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(exe_filter)
        dialog.set_filters(filters)

        dialog.open(self.win, None, self.on_file_selected)

    def on_file_selected(self, dialog, result):
        try:
            file = dialog.open_finish(result)
            file_path = file.get_path()
            self.exe_entry.set_text(file_path)
            
            base_name = os.path.splitext(os.path.basename(file_path))[0]
            suggested_name = " ".join(word.capitalize() for word in base_name.replace('_', ' ').replace('-', ' ').split())
            self.name_entry.set_text(suggested_name)
        except Exception:
            pass

    def on_create_clicked(self, widget):
        exe_path = self.exe_entry.get_text().strip()
        app_name = self.name_entry.get_text().strip()

        if not exe_path or not app_name:
            self.show_status("Error: Both fields are required!", error=True)
            return

        if not os.path.isfile(exe_path):
            self.show_status("Error: Invalid .exe file path!", error=True)
            return

        safe_name = re.sub(r'[^a-zA-Z0-9_-]', '', app_name.lower().replace(' ', '-'))
        exe_dir = os.path.dirname(exe_path)

        app_dir = os.path.expanduser("~/.local/share/applications")
        icon_dir = os.path.expanduser("~/.local/share/icons/hicolor/256x256/apps")
        os.makedirs(app_dir, exist_ok=True)
        os.makedirs(icon_dir, exist_ok=True)

        desktop_file = os.path.join(app_dir, f"wine-{safe_name}.desktop")
        icon_path = os.path.join(icon_dir, f"wine-{safe_name}.png")

        icon_value = "wine"
        try:
            wrestool = subprocess.Popen(["wrestool", "-x", "-t", "14", exe_path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            icotool = subprocess.Popen(["icotool", "-x", "-o", icon_path, "-"], stdin=wrestool.stdout, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            wrestool.stdout.close()
            icotool.communicate()

            if os.path.isfile(icon_path):
                icon_value = f"wine-{safe_name}"
            else:
                # Secondary loose extraction attempt if strict 256 fails
                wrestool = subprocess.Popen(["wrestool", "-x", "-t", "14", exe_path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                icotool = subprocess.Popen(["icotool", "-x", "-o", icon_dir, "-"], stdin=wrestool.stdout, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                wrestool.stdout.close()
                icotool.communicate()
                
                extracted_files = [os.path.join(icon_dir, f) for f in os.listdir(icon_dir) if f.endswith('.png') and not f.startswith('wine-')]
                if extracted_files:
                    biggest_file = max(extracted_files, key=os.path.getsize)
                    os.rename(biggest_file, icon_path)
                    icon_value = f"wine-{safe_name}"
                    for f in extracted_files:
                        if os.path.exists(f): os.remove(f)
        except Exception:
            pass 

        desktop_content = f"""[Desktop Entry]
Type=Application
Name={app_name}
Comment=Launched via Wine
Exec=env WINEPREFIX="{os.path.expanduser('~/.wine')}" wine "{exe_path}"
Path={exe_dir}
Icon={icon_value}
Terminal=false
StartupNotify=true
Categories=Wine;X-Wine-Programs;Application;
"""

        try:
            with open(desktop_file, "w") as f:
                f.write(desktop_content)
            os.chmod(desktop_file, 0o755)
            
            subprocess.run(["update-desktop-database", app_dir], stderr=subprocess.DEVNULL)
            self.show_status(f"Success! '{app_name}' is now a system app.", error=False)
        except Exception as e:
            self.show_status(f"Write failed: {str(e)}", error=True)

    def show_status(self, text, error=False):
        self.status_label.set_text(text)
        if error:
            self.status_label.set_markup(f"<span foreground='red'>{text}</span>")
        else:
            self.status_label.set_markup(f"<span foreground='green'><b>{text}</b></span>")

if __name__ == "__main__":
    app = WineAppBuilder()
    sys.exit(app.run(sys.argv))
